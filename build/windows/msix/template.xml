<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kolo-chat"
        Arguments=""
        InstallLocation="C:\Program Files\Ciranda\Kolo Chat">
    </Installer>
    <PackageInformation
        PackageName="Kolo Chat"
        PackageDisplayName="Kolo Chat"
        PublisherName="CN=Ciranda"
        PublisherDisplayName="Ciranda"
        Version="0.0.0.0"
        PackageDescription="Peer-to-peer desktop chat built with Kolo">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.ciranda.kolochat"
                Description="Peer-to-peer desktop chat built with Kolo"
                DisplayName="Kolo Chat"
                ExecutableName="kolo-chat"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Kolo Chat</DisplayName>
            <PublisherDisplayName>Ciranda</PublisherDisplayName>
            <Description>Peer-to-peer desktop chat built with Kolo</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kolo-chat.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
